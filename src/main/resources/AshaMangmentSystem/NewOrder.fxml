<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="899.0" prefWidth="1566.0"
	xmlns="http://javafx.com/javafx/17.0.13"
	xmlns:fx="http://javafx.com/fxml/1">
	<center>
		<TableView fx:id="productTable" prefHeight="665.0"
			prefWidth="990.0" BorderPane.alignment="TOP_CENTER">
			<BorderPane.margin>
				<Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
			</BorderPane.margin>
			<columns>
				<TableColumn prefWidth="326.4000053405762"
					text="Product ID" />
				<TableColumn prefWidth="813.5999145507812"
					text="Product Name" />
				<TableColumn prefWidth="352.0" text="Amount" />
			</columns>
			<columnResizePolicy>
				<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
			</columnResizePolicy>
		</TableView>
	</center>
	<bottom>
		<HBox prefHeight="62.0" prefWidth="1318.0"
			BorderPane.alignment="BOTTOM_LEFT">
			<children>
				<Button disable="true" mnemonicParsing="false" prefHeight="55.0"
					prefWidth="133.0" text="Remove">
					<HBox.margin>
						<Insets left="5.0" right="10.0" />
					</HBox.margin>
				</Button>
				<Button disable="true" layoutX="10.0" layoutY="10.0" mnemonicParsing="false"
					prefHeight="55.0" prefWidth="133.0" text="Add product" />
				<Button disable="true" layoutX="159.0" layoutY="10.0"
					mnemonicParsing="false" prefHeight="55.0" prefWidth="133.0"
					text="Confirm">
					<HBox.margin>
						<Insets left="600.0" />
					</HBox.margin>
				</Button>
			</children>
			<BorderPane.margin>
				<Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
			</BorderPane.margin>
		</HBox>
	</bottom>
	<top>
		<Pane prefHeight="66.0" prefWidth="1566.0"
			BorderPane.alignment="CENTER">
			<children>
				<DatePicker layoutX="191.0" layoutY="21.0"
					promptText="Date" />
				<Label layoutX="449.0" layoutY="15.0" prefHeight="36.0"
					prefWidth="112.0" text="Total price:" textAlignment="CENTER">
					<font>
						<Font size="22.0" />
					</font>
				</Label>
				<ComboBox layoutX="21.0" layoutY="21.0" prefWidth="150.0"
					promptText="Customer" />
				<Label layoutX="554.0" layoutY="17.0" prefHeight="36.0"
					prefWidth="112.0" text="0.00" textAlignment="CENTER">
					<font>
						<Font size="22.0" />
					</font>
				</Label>
			</children>
		</Pane>
	</top>
</BorderPane>
